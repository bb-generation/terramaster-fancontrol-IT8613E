[Unit]
Description=TerraMaster Fan Control Service
After=local-fs.target

[Service]
Type=simple
# Option 1: Use config file (recommended)
ExecStart=/usr/local/bin/fancontrol --config=/etc/fancontrol.conf
# Option 2: Use command line arguments with auto-detection
# ExecStart=/usr/local/bin/fancontrol --auto_detect --setpoint=37 --debug=0
# Option 3: Manually specify drives
# ExecStart=/usr/local/bin/fancontrol --drive_list="sda,sdb,sdc,sdd,nvme0n1" --setpoint=37 --debug=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
