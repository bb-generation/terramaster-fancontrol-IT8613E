[Unit]
Description=TerraMaster Fan Control Service
# zfs-mount.service: the binary and config live on a pool
After=local-fs.target zfs-mount.service

[Service]
Type=simple
# install_service.sh rewrites this to the binary and config next to it
ExecStart=/usr/local/bin/fancontrol --config=/etc/fancontrol.conf
Restart=on-failure
RestartSec=10

# Hardening (root is still required for raw IO port access via iopl)
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
